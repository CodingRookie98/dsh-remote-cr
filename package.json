{
  "name": "dsh-remote-cr",
  "version": "0.2.0",
  "private": true,
  "description": "dsh-remote-cr：DeepSeek Harness 的远端宿主远程开发插件（B 型：宿主远端、单一原生 GUI、凭据不出本机）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/CodingRookie98/dsh-remote-cr.git"
  },
  "homepage": "https://github.com/CodingRookie98/dsh-remote-cr#readme",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "remote-development", "ssh", "wsl"],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./shared": {
      "types": "./lib/shared/index.d.ts",
      "default": "./lib/shared/index.js"
    },
    "./local": {
      "types": "./lib/local/index.d.ts",
      "default": "./lib/local/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./companion": {
      "types": "./lib/companion/index.d.ts",
      "default": "./lib/companion/index.js"
    },
    "./installer": {
      "types": "./lib/installer/index.d.ts",
      "default": "./lib/installer/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.0 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "e2e:preview": "node scripts/preview-wizard.mjs --no-build",
    "e2e:host": "node spikes/m4/add-workspace-ui/probe.cjs",
    "spike:t5": "node spikes/m1/cross-machine-t5/probe.cjs",
    "spike:t6": "node spikes/m1/cross-machine-t6/probe.cjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.1-rc.0 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-gateway": ">=0.2.1-rc.0 <0.3.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-rc.0 <0.3.0",
    "@deepseek-ai/dsh-app-boot": ">=0.2.1-rc.0 <0.3.0",
    "@deepseek-ai/dsh-client-connection": ">=0.2.1-rc.0 <0.3.0",
    "@deepseek-ai/dsh-scope": ">=0.2.1-rc.0 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.5",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.5",
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
