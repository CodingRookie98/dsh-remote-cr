# deps / build
node_modules/
dist/
lib/
*.tsbuildinfo
pnpm-lock.yaml.bak*
*.log

# local runtime artifacts
.dsh-teleport/
.remote-test/
test-artifacts/

# review runtime state (dual-round-review anchors; never versioned)
.review-context/
