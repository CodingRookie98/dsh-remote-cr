# deps / build
node_modules/
dist/
# lib/ **入库**：`package.json#main` 指向 lib/index.js，GitHub 安装（`dsh plugin add github:...`）
# 不会在用户机器上跑 tsc，必须带构建产物。CI 仍会重跑 build 以保证产物与源码一致。
*.tsbuildinfo
pnpm-lock.yaml.bak*
*.log

# local runtime artifacts
.dsh-remote-cr/
.remote-test/
test-artifacts/
# 预览 harness（scripts/preview-wizard.mjs）的截图与 dump：生成物，不入库
# 用 .preview*/ 覆盖 --out 指定的变体目录（.preview-v2 / .preview-v4 …）
.preview*/

# review runtime state (dual-round-review anchors; never versioned)
.review-context/
# goal-loop 派发账本与检查点：高频易变运行时状态，只在本机保留，不入库
.goal-loop/

# local spike scratch space (isolated DSH_HOME, chrome profiles, probe logs)
.tmp-spike/
# CDP probe runtime state: headless Chrome profiles are created beside the scripts
spikes/**/cdp/chrome-profile*/
# 运行时生成物：含 ed25519 私钥（hostkey/clientkey）、pid、日志 —— 绝不入库
spikes/**/work/

# local agent / scratch state
.agents/
.tmp-*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# secrets — never commit
.credentials.yaml
*.pem
skills-lock.json
.agents/skills/
